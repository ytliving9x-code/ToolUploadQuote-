# ==============================================================================
# TikTok Aesthetic Quote Video Generator - Environment Variables
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env và điền các API key của bạn:
#   copy .env.example .env
# ==============================================================================

# Pexels API Key (Lấy miễn phí tại: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Lấy tại: https://platform.openai.com/api-keys)
# Chỉ cần nếu bạn chọn llm_provider là "openai" trong config.json hoặc app
OPENAI_API_KEY=your_openai_api_key_here
